# Proxy targets for Caddy (used by docker compose).
#
# Bridge mode (default compose): container reaches beava via the host gateway.
# Beava must listen on 0.0.0.0 (not 127.0.0.1) or use compose.stack.yml /
# compose.host-network.yml instead.
#
# BEAVA_ADMIN_UPSTREAM=http://host.docker.internal:8090
# BEAVA_DATA_UPSTREAM=http://host.docker.internal:8080
#
# Host-network mode (Linux + Cloudflare tunnel + beava on 127.0.0.1):
# ADMIN_LISTEN=:3000
# BEAVA_ADMIN_UPSTREAM=http://127.0.0.1:8090
# BEAVA_DATA_UPSTREAM=http://127.0.0.1:8080
#
# Stack mode (beava in compose on the same Docker network):
# BEAVA_ADMIN_UPSTREAM=http://beava:8090
# BEAVA_DATA_UPSTREAM=http://beava:8080
